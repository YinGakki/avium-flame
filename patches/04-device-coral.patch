From 0dacdca015f52d2794d3f5c80f9da9da0e058e09 Mon Sep 17 00:00:00 2001
From: builder <b@x>
Date: Mon, 23 Nov 2026 16:21:19 +0800
Subject: [PATCH 1/3] trim: drop Velvet/Bugle/DevicePersonalization
 x2/GoogleDialer to fit super

---
 lineage_flame.mk | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/lineage_flame.mk b/lineage_flame.mk
index 508369f3..879d64bb 100644
--- a/lineage_flame.mk
+++ b/lineage_flame.mk
@@ -68,3 +68,15 @@ PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
     system/priv-app/TagGoogle/TagGoogle.apk \
     system/etc/permissions/privapp-permissions-google.xml \
     system/etc/permissions/privapp_allowlist_com.google.android.ext.services.xml
+
+# ---- 裁剪体积以适配 super 分区容量 ----
+# 移除体积大且非必需的 GMS/预置应用（用户确认，2026-11-23）
+# 被裁: Velvet(Google搜索338M) PrebuiltBugle(短信150M) DevicePersonalizationPixel2024(118M) DevicePersonalizationPixel4(63M) GoogleDialer(84M)
+# 如需恢复，删除下面这段即可（原文件备份: lineage_flame.mk.bak）
+PRODUCT_PACKAGES := $(filter-out \
+    Velvet \
+    PrebuiltBugle \
+    DevicePersonalizationPrebuiltPixel2024-playstore_aiai_20250306.00_RC10 \
+    DevicePersonalizationPrebuiltPixel4 \
+    GoogleDialer, \
+    $(PRODUCT_PACKAGES))
-- 
2.43.0


