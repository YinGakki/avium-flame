From 8e157643fd96d0a6586a8fbb223675e9d2c82351 Mon Sep 17 00:00:00 2001
From: builder <b@x>
Date: Wed, 25 Nov 2026 21:17:35 +0800
Subject: [PATCH 1/5] avium: add aviumctl root boot-switch (init service +
 sepolicy)

Change-Id: I2bea4107878002a4259563fc8432c1476a06f4de
---
 config/avium.mk                          |  3 ++-
 prebuilt/common/bin/avium-root-switch.sh | 20 ++++++++++++++++++++
 prebuilt/common/etc/init/init.avium.rc   |  7 ++++++-
 sepolicy/common/private/init.te          |  9 ++++++++-
 4 files changed, 36 insertions(+), 3 deletions(-)
 create mode 100644 prebuilt/common/bin/avium-root-switch.sh

diff --git a/config/avium.mk b/config/avium.mk
index f6eef74..2473474 100644
--- a/config/avium.mk
+++ b/config/avium.mk
@@ -63,4 +63,5 @@ $(call inherit-product, vendor/avium/config/prop.mk)
 
 # AviumUI init
 PRODUCT_COPY_FILES += \
-     vendor/avium/prebuilt/common/etc/init/init.avium.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/init.avium.rc
+     vendor/avium/prebuilt/common/etc/init/init.avium.rc:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/init/init.avium.rc \
+     vendor/avium/prebuilt/common/bin/avium-root-switch.sh:$(TARGET_COPY_OUT_SYSTEM_EXT)/bin/avium-root-switch.sh
diff --git a/prebuilt/common/bin/avium-root-switch.sh b/prebuilt/common/bin/avium-root-switch.sh
new file mode 100644
index 0000000..a1d8a8b
--- /dev/null
+++ b/prebuilt/common/bin/avium-root-switch.sh
@@ -0,0 +1,20 @@
+#!/system/bin/sh
+# AviumUI root switch: flash selected boot image to current slot boot partition.
+# Triggered by init on property change of persist.avium.root (1=ksu, 0=default).
+LOG=/data/system/avium/root-switch.log
+mkdir -p /data/system/avium 2>/dev/null
+exec >>"$LOG" 2>&1
+echo "=== $(date) root-switch triggered ==="
+VAL=$(getprop persist.avium.root)
+SLOT=$(getprop ro.boot.slot_suffix)
+[ -z "$SLOT" ] && SLOT="_a"
+echo "persist.avium.root=$VAL slot=$SLOT"
+if [ "$VAL" = "1" ]; then IMG=/sdcard/avium/boot_ksu.img; else IMG=/sdcard/avium/boot_default.img; fi
+echo "target image: $IMG"
+if [ ! -f "$IMG" ]; then echo "MISSING $IMG, abort"; exit 1; fi
+BLK=/dev/block/bootdevice/by-name/boot${SLOT}
+[ -e "$BLK" ] || BLK=/dev/block/by-name/boot${SLOT}
+echo "flashing $IMG -> $BLK"
+dd if="$IMG" of="$BLK" bs=4096 2>&1
+sync
+echo "done rc=$?"
diff --git a/prebuilt/common/etc/init/init.avium.rc b/prebuilt/common/etc/init/init.avium.rc
index 013e3d4..1d04fb2 100644
--- a/prebuilt/common/etc/init/init.avium.rc
+++ b/prebuilt/common/etc/init/init.avium.rc
@@ -13,4 +13,9 @@ on property:persist.avium.depthwallpaper=0
     copy /system_ext/media/wallpaper/mask /data/system/avium/mask
     copy /system_ext/media/wallpaper/wallpaper /data/system/avium/wallpaper
     chmod 0777 /data/system/avium/mask
-    chmod 0777 /data/system/avium/wallpaper
\ No newline at end of file
+    chmod 0777 /data/system/avium/wallpaper
+
+on property:persist.avium.root=1
+    exec - root -- /system/bin/sh /system_ext/bin/avium-root-switch.sh
+on property:persist.avium.root=0
+    exec - root -- /system/bin/sh /system_ext/bin/avium-root-switch.sh
diff --git a/sepolicy/common/private/init.te b/sepolicy/common/private/init.te
index 3a64af2..ac29491 100644
--- a/sepolicy/common/private/init.te
+++ b/sepolicy/common/private/init.te
@@ -1,2 +1,9 @@
 allow init avium_metadata_file:dir { read write add_name remove_name search open };
-allow init avium_metadata_file:file { read write open create getattr setattr unlink };
\ No newline at end of file
+allow init avium_metadata_file:file { read write open create getattr setattr unlink };
+
+# AviumUI root switch: dd boot image to boot partition (aviumctl)
+allow init media_rw_data_file:dir { search open read getattr };
+allow init media_rw_data_file:file { open read getattr };
+allow init boot_block_device:blk_file { open write getattr };
+allow init system_data_file:dir { search open read write add_name create getattr };
+allow init system_data_file:file { open read write create getattr };

