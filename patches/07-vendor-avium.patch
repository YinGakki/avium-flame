From 3bd5b95cc08498e4541c21975632d3f1e229baaf Mon Sep 17 00:00:00 2001
From: builder <b@x>
Date: Thu, 26 Nov 2026 16:07:08 +0800
Subject: [PATCH 4/5] avium: read boot images from unencrypted data path

Change-Id: I63a5ed4064f28ad451820d09e83d02493abf27dd
---
 prebuilt/common/bin/avium-root-switch.sh | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/prebuilt/common/bin/avium-root-switch.sh b/prebuilt/common/bin/avium-root-switch.sh
index a4600c1..70b1fbd 100644
--- a/prebuilt/common/bin/avium-root-switch.sh
+++ b/prebuilt/common/bin/avium-root-switch.sh
@@ -9,7 +9,12 @@ VAL=$(getprop persist.avium.root)
 SLOT=$(getprop ro.boot.slot_suffix)
 [ -z "$SLOT" ] && SLOT="_a"
 echo "persist.avium.root=$VAL slot=$SLOT"
-if [ "$VAL" = "1" ]; then IMG=/data/avium/boot_ksu.img; else IMG=/data/avium/boot_default.img; fi
+if [ "$VAL" = "1" ]; then NAME=boot_ksu.img; else NAME=boot_default.img; fi
+IMG=""
+for D in /data/unencrypted/avium /data/avium; do
+    if [ -f "$D/$NAME" ]; then IMG="$D/$NAME"; break; fi
+done
+[ -n "$IMG" ] || IMG="/data/unencrypted/avium/$NAME"
 echo "target image: $IMG"
 if [ ! -f "$IMG" ]; then echo "MISSING $IMG, abort"; exit 1; fi
 BLK=/dev/block/bootdevice/by-name/boot${SLOT}

