+#!/system/bin/sh
+# AviumUI GPhotos spoof switch: enable/disable PixelifyPhotos module in KSU.
+LOG=/data/system/avium/gphotos-switch.log
+mkdir -p /data/system/avium /data/adb/modules 2>/dev/null
+exec >>"$LOG" 2>&1
+echo "=== $(date) gphotos switch ==="
+ROOT=$(getprop persist.avium.root)
+VAL=$(getprop persist.avium.gphotos)
+[ -z "$ROOT" ] && ROOT=0
+[ -z "$VAL" ] && VAL=0
+MOD=/data/adb/modules/PixelifyPhotos
+echo "root=$ROOT gphotos=$VAL module=$MOD"
+if [ ! -d "$MOD" ]; then
+    mkdir -p "$MOD/zygisk" "$MOD/system/etc/sysconfig" "$MOD/system/product/etc/sysconfig" 2>/dev/null
+    cp -a /system_ext/etc/avium/modules/PixelifyPhotos/. "$MOD"/ 2>/dev/null
+    chmod -R 0755 "$MOD" 2>/dev/null
+fi
+if [ "$ROOT" = "1" ] && [ "$VAL" = "1" ]; then rm -f "$MOD/disable"; else touch "$MOD/disable"; fi
+echo 'GPHOTOS_SWITCH_DONE'
