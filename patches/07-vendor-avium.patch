--- /dev/null
+++ b/prebuilt/common/bin/avium-volte-switch.sh
@@ -0,0 +1,21 @@
+#!/system/bin/sh
+# AviumUI real VoLTE switch: bind-mount selected MBN set over vendor mcfg_sw.
+LOG=/data/system/avium/volte-switch.log
+mkdir -p /data/system/avium 2>/dev/null
+exec >>"$LOG" 2>&1
+echo "=== $(date) volte switch ==="
+VAL=$(getprop persist.avium.volte)
+[ -z "$VAL" ] && VAL=1
+TARGET=/vendor/rfs/msm/mpss/readonly/vendor/mbn/mcfg_sw
+if [ "$VAL" = "1" ]; then SRC=/system_ext/etc/avium/volte/cn/mcfg_sw; else SRC=/system_ext/etc/avium/volte/stock/mcfg_sw; fi
+echo "persist.avium.volte=$VAL src=$SRC target=$TARGET"
+if grep -q " $TARGET " /proc/mounts; then
+    umount "$TARGET"
+fi
+mount -o bind "$SRC" "$TARGET"
+echo "mount rc=$?"
+for p in persist.dbg.ims_volte_enable persist.dbg.volte_avail_ovr persist.dbg.vt_avail_ovr persist.dbg.wfc_avail_ovr; do
+    setprop "$p" "$VAL"
+done
+rm -f /data/vendor/modem_fdr/fdr_check 2>/dev/null
+echo 'VOLTE_SWITCH_DONE'
