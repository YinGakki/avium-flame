--- /dev/null
+++ b/prebuilt/common/bin/avium-boot-prepare.sh
@@ -0,0 +1,47 @@
+#!/system/bin/sh
+# Runs early at boot (post-fs-data), before other partitions settle.
+# 1) VoLTE: bind-mount the selected MBN set BEFORE modem reads it.
+# 2) Root: if pending flag differs from what is flashed, dd the right boot image.
+LOG=/data/avium-boot.log
+mkdir -p /data/system/avium 2>/dev/null
+exec >>"$LOG" 2>&1
+echo "=== boot-prepare $(date) slot=$(getprop ro.boot.slot_suffix) ==="
+
+ROOT=$(getprop persist.avium.root)
+VOLTE=$(getprop persist.avium.volte)
+[ -z "$ROOT" ] && ROOT=0
+[ -z "$VOLTE" ] && VOLTE=1
+echo "persist.avium.root=$ROOT persist.avium.volte=$VOLTE"
+
+# ---- VoLTE MBN set ----
+TARGET=/vendor/rfs/msm/mpss/readonly/vendor/mbn/mcfg_sw
+if [ "$VOLTE" = "1" ]; then SRC=/system_ext/etc/avium/volte/cn/mcfg_sw; else SRC=/system_ext/etc/avium/volte/stock/mcfg_sw; fi
+if [ -d "$SRC" ] && [ -d "$TARGET" ]; then
+    mount -o bind "$SRC" "$TARGET"
+    echo "volte bind rc=$? src=$SRC"
+else
+    echo "volte skip: src=$SRC target=$TARGET"
+fi
+setprop persist.dbg.ims_volte_enable "$VOLTE"
+setprop persist.dbg.volte_avail_ovr "$VOLTE"
+setprop persist.dbg.vt_avail_ovr "$VOLTE"
+setprop persist.dbg.wfc_avail_ovr "$VOLTE"
+rm -f /data/vendor/modem_fdr/fdr_check 2>/dev/null
+
+# ---- Root boot image ----
+SLOT=$(getprop ro.boot.slot_suffix)
+[ -z "$SLOT" ] && SLOT=_a
+if [ "$ROOT" = "1" ]; then NAME=boot_ksu.img; else NAME=boot_default.img; fi
+IMG=/system_ext/etc/avium/boot/$NAME
+if [ ! -f "$IMG" ]; then echo "root skip: missing $IMG"; else
+    BLK=/dev/block/bootdevice/by-name/boot${SLOT}
+    [ -e "$BLK" ] || BLK=/dev/block/by-name/boot${SLOT}
+    if [ -e "$BLK" ]; then
+        dd if="$IMG" of="$BLK" bs=4096 2>&1
+        sync
+        echo "root flashed $IMG -> $BLK rc=$?"
+    else
+        echo "root skip: no block $BLK"
+    fi
+fi
+echo 'BOOT_PREPARE_DONE'
