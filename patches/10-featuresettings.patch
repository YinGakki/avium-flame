@@ -77,6 +77,24 @@ class CategorySettingsFragment : SettingsBasePreferenceFragment() {
         category.isVisible = category.preferenceCount > 0
     }
 
+    private fun launchKsuManager() {
+        val ctx = requireContext()
+        val candidates = listOf(
+            "com.sukisu.ultra", "me.weishu.kernelsu", "com.sukisu.nova",
+            "io.github.sukisu", "com.sukisu.manager"
+        )
+        for (pkg in candidates) {
+            val intent = ctx.packageManager.getLaunchIntentForPackage(pkg)
+            if (intent != null) { startActivity(intent); return }
+        }
+        try {
+            startActivity(Intent(android.provider.Settings.ACTION_APPLICATION_DETAILS_SETTINGS,
+                android.net.Uri.parse("package:" + candidates.first())))
+        } catch (e: Exception) {
+            android.widget.Toast.makeText(ctx, "未找到 SukiSU Manager", android.widget.Toast.LENGTH_SHORT).show()
+        }
+    }
+
     private fun getCategoryXml(category: SettingsCategory): Int {
         return when (category) {
             SettingsCategory.STATUS_BAR -> R.xml.feature_settings_ui
@@ -211,6 +229,31 @@ class CategorySettingsFragment : SettingsBasePreferenceFragment() {
      */
     private fun bindSystemPreferences() {
 
+        // ===== Avium Root / Pixel features (added) =====
+        bindSwitch(KEY_AVIUM_ROOT_ENABLE, SystemPropertiesHelper.getBoolean(PROP_AVIUM_ROOT, false)) { enabled ->
+            SystemPropertiesHelper.set(PROP_AVIUM_ROOT, if (enabled) "1" else "0")
+            showRebootRequiredDialog()
+        }
+        findPreference<Preference>(KEY_AVIUM_ROOT_MANAGER)?.apply {
+            isPersistent = false
+            setOnPreferenceClickListener {
+                launchKsuManager()
+                true
+            }
+        }
+        bindSwitch(KEY_AVIUM_VOLTE_FIX, SystemPropertiesHelper.getBoolean(PROP_AVIUM_VOLTE, true)) { enabled ->
+            val v = if (enabled) "1" else "0"
+            SystemPropertiesHelper.set(PROP_AVIUM_VOLTE, v)
+            SystemPropertiesHelper.set("persist.dbg.ims_volte_enable", v)
+            SystemPropertiesHelper.set("persist.dbg.volte_avail_ovr", v)
+            SystemPropertiesHelper.set("persist.dbg.vt_avail_ovr", v)
+            SystemPropertiesHelper.set("persist.dbg.wfc_avail_ovr", v)
+        }
+        bindSwitch(KEY_AVIUM_GPHOTOS, SystemPropertiesHelper.getBoolean(PROP_AVIUM_GPHOTOS, false)) { enabled ->
+            SystemPropertiesHelper.set(PROP_AVIUM_GPHOTOS, if (enabled) "1" else "0")
+        }
+        // ===== end added =====
+
         bindSwitch(
             KEY_FORCE_6GHZ_HOTSPOT,
             SystemPropertiesHelper.getBoolean(FORCE_6GHZ_HOTSPOT_PROPERTY, false)
@@ -697,6 +740,13 @@ class CategorySettingsFragment : SettingsBasePreferenceFragment() {
         private const val KEY_GMS_ENABLED = "gms_enabled"
 
